{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "go@dev-plugins": true,
    "react-nextjs@dev-plugins": true,
    "ux@dev-plugins": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go mod verify)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(gotestsum:*)",
      "Bash(task:*)",
      "Bash(wails3 doctor)",
      "Bash(wails3 version)",
      "Bash(pnpm install)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)",
      "Bash(task build)",
      "Bash(pnpm add:*)",
      "Bash(go get:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/secrets*)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/dist/assets/**)",
      "Read(./bin/**)",
      "Read(./build/bin/**)",
      "Read(./dist-installers/**)",
      "Read(./.pnpm-store/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) command -v gofmt >/dev/null && gofmt -w \"$f\" ;; esac; }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go vet ./... 2>&1 | head -20",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
