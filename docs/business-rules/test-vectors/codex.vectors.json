      },
      {
        "id": "no-file-on-disk-falls-back-to-none",
        "input": {
          "modelsCacheJson": null
        },
        "expected": {
          "result": null
        },
        "notes": "The original test seeds an empty temp directory (no models_cache.json at all); modelled here as a null input rather than a real filesystem read."
      },
      {
        "id": "a-catalog-with-nothing-listed-falls-back-to-none",
        "input": {
          "modelsCacheJson": "{\"models\":[{\"slug\":\"x\",\"visibility\":\"hidden\"}]}"
        },
        "expected": {
          "result": null
        },
        "notes": "An empty result list is folded into None (not Some([])) so the frontend's curated-list fallback still applies."
