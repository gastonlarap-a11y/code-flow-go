<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
            <string>APPL</string>
        <key>CFBundleName</key>
            <string>CodeFlow</string>
        <key>CFBundleExecutable</key>
            <string>CodeFlow</string>
        <key>CFBundleIdentifier</key>
            <string>com.codeflow.app</string>
        <!-- Placeholders. `package:mac` overwrites both with the VERSION it was built with, in the
             copy inside the bundle, before the bundle is signed. Written as 0.0.0 to match the
             Taskfile's own default, so a bundle that escaped that step is obvious rather than
             plausible: these two said 3.0.0 through every release up to 3.3.0, and Finder's Get
             Info reported 3.0.0 for a download that was not. -->
        <key>CFBundleVersion</key>
            <string>0.0.0</string>
        <key>CFBundleGetInfoString</key>
            <string>CodeFlow — code review and API workbench</string>
        <key>CFBundleShortVersionString</key>
            <string>0.0.0</string>
        <key>CFBundleIconFile</key>
            <string>icons</string>
        <key>CFBundleIconName</key>
            <string>appicon</string>
        <!-- 26.0, not Wails' default 12.0 (§14 D3). The renderer uses CSS anchor positioning, the
             Popover API and light-dark() natively, with no fallback path built, because every macOS
             Apple still supports ships Safari 26+. Claiming 12.0 would let this install on a machine
             whose WKWebView cannot lay the UI out at all. -->
        <key>LSMinimumSystemVersion</key>
            <string>26.0.0</string>
        <key>NSHighResolutionCapable</key>
            <string>true</string>
        <!-- What Finder's Get Info shows about a bundle the operating system has just called
             unverifiable, which is the moment a user most wants to know whose it is. -->
        <key>NSHumanReadableCopyright</key>
            <string>© Gastón Lara P.</string>
    </dict>
</plist>