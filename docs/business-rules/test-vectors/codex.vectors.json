    ],
    "kind": "vector",
    "unit": "interpret_output",
    "cases": [
      {
        "id": "a-successful-run-returns-stdout-as-the-reply",
        "input": {
          "success": true,
          "statusLabel": "exit status: 0",
          "stdout": "  feat: add thing  ",
          "stderr": "thinking…"
        },
        "expected": {
          "text": "feat: add thing",
          "sessionId": null
        },
        "notes": "stderr carries only progress chatter here, no 'session id:' line, so no session is reported."
      },
      {
        "id": "captures-the-rollout-id-from-the-stderr-preamble",
        "input": {
          "success": true,
          "statusLabel": "exit status: 0",
          "stdout": "done",
          "stderr": "OpenAI Codex v0.114.0 (research preview)\n--------\nworkdir: /home/u/project\nmodel: gpt-5.3-codex\nprovider: openai\napproval: never\nsandbox: read-only\nsession id: 019ce7d6-5962-7f21-9f20-95ebe6504c32\n--------\n"
        },
        "expected": {
          "text": "done",
          "sessionId": "019ce7d6-5962-7f21-9f20-95ebe6504c32"
        }
      },
      {
        "id": "reports-no-session-when-the-preamble-omits-the-id",
        "input": {
          "success": true,
          "statusLabel": "exit status: 0",
          "stdout": "done",
          "stderr": "OpenAI Codex v0.1\nmodel: gpt\n"
        },
        "expected": {
          "text": "done",
          "sessionId": null
        }
      },
      {
        "id": "an-ordinary-reply-mentioning-401-is-still-a-reply",
        "input": {
          "success": true,
          "statusLabel": "exit status: 0",
          "stdout": "Finding: the endpoint returns 401 Unauthorized when the token is missing, and authentication failed is never handled by the caller.",
          "stderr": ""
        },
        "expected": {
          "text": "Finding: the endpoint returns 401 Unauthorized when the token is missing, and authentication failed is never handled by the caller.",
          "sessionId": null
        },
        "notes": "The regression guard for AUTH_EXPIRED::. This text matches the AUTH_SIGNALS dictionary twice over, and must still come back as a reply: a review that discusses authentication is the commonest thing an engine writes, and marking it would throw the finished review away exactly as BUG-AI-b does for quota. What keeps it safe is placement — AuthSignals is consulted only on a failure path — so this case fails the moment that placement is widened."
      },
      {
        "id": "surfaces-the-failure-detail",
        "input": {
          "success": false,
          "statusLabel": "exit status: 1",
          "stdout": "",
          "stderr": "not logged in — run `codex login`"
        },
        "expected": {
          "error": "AUTH_EXPIRED::not logged in — run `codex login`"
        },
        "notes": "A lost ChatGPT login. It used to read as the generic exit-status wrapper; AUTH_EXPIRED:: replaces the wrapper rather than adding to it, because the CLI's own sentence is the reason and the exit status adds nothing to it (XLANG-003)."
      },
      {
        "id": "a-plan-limit-message-gets-the-marker",
        "input": {
          "success": false,
          "statusLabel": "exit status: 1",
          "stdout": "",
          "stderr": "You've hit your usage limit"
        },
        "expected": {
          "error": "QUOTA_EXCEEDED::You've hit your usage limit"
        }
      },
      {
        "id": "progress-on-stderr-is-not-mistaken-for-an-error-on-a-clean-exit",
        "input": {
          "success": true,
          "statusLabel": "exit status: 0",
          "stdout": "done",
          "stderr": "[2026] running…"
        },
        "expected": {
          "text": "done"
        }
      }
    ]
  },
